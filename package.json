{
  "name": "tv-launcher",
  "productName": "Lounge",
  "version": "1.4.1",
  "description": "Apple-TV-Style Launcher mit Smartphone-Fernbedienung",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish onTag",
    "dist:win": "electron-builder --win --x64 --publish onTag",
    "dist:mac": "electron-builder --mac dmg --universal --publish onTag",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish onTag"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.lounge",
    "productName": "Lounge",
    "files": [
      "main.js",
      "preload.js",
      "account.js",
      "updater.js",
      "backend.json",
      "renderer/**",
      "remote/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "extraResources": [
        {
          "from": "scripts",
          "to": "scripts"
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "identity": null,
      "artifactName": "Lounge-macOS.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "artifactName": "Lounge-Linux.${ext}"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lounge-Windows-Setup.${ext}",
      "runAfterFinish": true,
      "shortcutName": "Lounge",
      "uninstallDisplayName": "Lounge"
    },
    "portable": {
      "artifactName": "Lounge-Windows-Portable.${ext}"
    }
  },
  "repository": "github:OWNER/REPO"
}